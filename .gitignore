# ==============================================================================
# NewsBias Production .gitignore
# Ensures ONLY clean, required source code and assets are tracked in Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Keys & Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.pub
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
google-services.json
.aws/
.azure/
.gcp/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.Python
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Machine Learning Weights & Large Binaries (Hosted on Hugging Face Hub)
# ------------------------------------------------------------------------------
data/
models/
results/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5
*.tflite
*.ckpt
*.joblib
*.pkl
*.pickle
*.parquet
*.arrow

# ------------------------------------------------------------------------------
# Databases & Transient State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.rdb

# ------------------------------------------------------------------------------
# HuggingFace & Framework Caches
# ------------------------------------------------------------------------------
.cache/
hf_cache/
torch_cache/
transformers_cache/

# ------------------------------------------------------------------------------
# Android & Gradle Build Artifacts
# ------------------------------------------------------------------------------
.gradle/
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/.kotlin/
android/local.properties
android/*.iml
android/app/*.iml
android/captures/
captures/
*.apk
*.aab
*.ap_
*.hprof

# ------------------------------------------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml

# ------------------------------------------------------------------------------
# IDE, Editor & Operating System Artifacts
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
*.sublime-workspace
*.sublime-project
*.suo
*.user
*.userosv

# Windows OS
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# Scratch Files, Logs & Process IDs
# ------------------------------------------------------------------------------
scratch/
*.log
*.pid
