# An OpenAI-compatible Chat Completions endpoint. Do not commit your real .env.
# For local Ollama, the key is ignored but still required by this client.
LLM_API_KEY=ollama
LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL=qwen3:8b
# Optional. Defaults to data/articles.db.
# ARTICLES_DB=data/articles.db
